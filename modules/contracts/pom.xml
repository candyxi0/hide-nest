<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.candyxi0.hidenest</groupId>
        <artifactId>hide-nest-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>hide-nest-contracts</artifactId>
    <name>hide-nest-contracts</name>
    <description>Contract-first generated API interfaces and DTOs</description>

    <properties>
        <hdm.java.output>${project.build.directory}/generated-sources/api</hdm.java.output>
        <hdm.openapi.ts.output>${project.build.directory}/generated-sources/typescript-fetch</hdm.openapi.ts.output>
        <hdm.events.ts.output>${project.build.directory}/generated-sources/events</hdm.events.ts.output>
    </properties>

    <dependencies>
        <!-- Spring Web for generated Spring MVC annotations -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Retained only if the generator emits @Valid for request bodies. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- JSON Schema validation (test scope only) -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>3.0.6</version>
            <scope>test</scope>
        </dependency>

        <!-- Test framework -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- YAML parsing for contract tests (managed by Boot parent) -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- OpenAPI Generator: Java interfaces + DTOs, OpenAPI TS client, and event TS models -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.24.0</version>
                <executions>
                    <execution>
                        <id>generate-java-api</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <generatorName>spring</generatorName>
                            <inputSpec>${project.basedir}/../../contracts/openapi/hide-nest-api.yaml</inputSpec>
                            <output>${hdm.java.output}</output>
                            <apiPackage>io.github.candyxi0.hidenest.contracts.api</apiPackage>
                            <modelPackage>io.github.candyxi0.hidenest.contracts.model</modelPackage>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                                <useSpringBoot3>true</useSpringBoot3>
                                <annotationLibrary>none</annotationLibrary>
                                <documentationProvider>none</documentationProvider>
                                <openApiNullable>false</openApiNullable>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <useBeanValidation>false</useBeanValidation>
                                <performBeanValidation>false</performBeanValidation>
                                <skipDefaultInterface>true</skipDefaultInterface>
                            </configOptions>
                            <addCompileSourceRoot>true</addCompileSourceRoot>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-typescript-fetch</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <generatorName>typescript-fetch</generatorName>
                            <inputSpec>${project.basedir}/../../contracts/openapi/hide-nest-api.yaml</inputSpec>
                            <output>${hdm.openapi.ts.output}</output>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <configOptions>
                                <supportsES6>true</supportsES6>
                                <importFileExtension>.js</importFileExtension>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-event-typescript</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <generatorName>typescript-fetch</generatorName>
                            <inputSpec>${project.basedir}/../../contracts/generator/events-openapi.yaml</inputSpec>
                            <output>${hdm.events.ts.output}</output>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <modelNameMappings>PinkEventEnvelope_aggregate=AggregateRef,PinkEventEnvelope_manifest=EventManifestRef</modelNameMappings>
                            <configOptions>
                                <supportsES6>true</supportsES6>
                                <importFileExtension>.js</importFileExtension>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
