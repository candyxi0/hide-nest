<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.candyxi0.hidenest</groupId>
    <artifactId>hide-nest-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>hide-nest-parent</name>
    <description>hide-nest modular monolith parent</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <modules>
        <module>modules/payload-adapter</module>
        <module>modules/evidence</module>
        <module>modules/memory</module>
        <module>modules/runtime</module>
        <module>modules/security</module>
        <module>modules/application</module>
        <module>modules/database-adapter</module>
        <module>modules/contracts</module>
        <module>apps/api</module>
        <module>apps/worker</module>
        <module>modules/architecture-tests</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.9.0</version>
                <configuration>
                    <java>
                        <palantirJavaFormat/>
                        <excludes>
                            <exclude>**/generated-sources/**</exclude>
                            <exclude>**/src/generated/java/**</exclude>
                        </excludes>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
